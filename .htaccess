<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Canonical host: www → apex (keeps session cookies valid)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Block hidden / sensitive paths
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    # Fichiers publics (images produits…) : /storage/x -> public/storage/x s'il existe ; le reste de storage/ reste interdit
    RewriteCond %{DOCUMENT_ROOT}/public/storage/$1 -f
    RewriteRule ^storage/(.+)$ public/storage/$1 [L]
    RewriteCond %{DOCUMENT_ROOT}/storage/app/public/$1 -f
    RewriteRule ^storage/(.+)$ storage/app/public/$1 [END]
    RewriteCond %{REQUEST_URI} ^/storage/
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^bootstrap/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^tests/ - [F,L]

    # Map the site to Laravel's public folder
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

DirectoryIndex index.php public/index.php

Options -Indexes

<FilesMatch "(^\.env|^\.git|composer\.(json|lock)|artisan|package\.json|phpunit\.xml)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
