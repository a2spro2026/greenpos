<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block hidden / sensitive paths
    RewriteRule ^\.env - [F,L]
    RewriteRule ^\.git - [F,L]
    RewriteRule ^storage/ - [F,L]
    RewriteRule ^vendor/ - [F,L]
    RewriteRule ^bootstrap/ - [F,L]
    RewriteRule ^database/ - [F,L]
    RewriteRule ^tests/ - [F,L]

    # Map the site to Laravel's public folder
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^((?!public/).*)$ public/$1 [L]
</IfModule>

DirectoryIndex index.php public/index.php

Options -Indexes

<FilesMatch "(^\.env|^\.git|composer\.(json|lock)|artisan|package\.json|phpunit\.xml)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
